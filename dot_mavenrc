# JDK public roots + internal SMX Root CAs (exported from the macOS keychain).
# Rebuild with `java-truststore-sync` after a JDK upgrade or CA change.
MAVEN_OPTS="$MAVEN_OPTS -Djavax.net.ssl.trustStore=$HOME/.local/share/java/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=changeit"
